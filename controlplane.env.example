# Copy to .env next to docker-compose.controlplane.yml and fill in.
# Generate a password:  python -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=contextshrink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=contextshrink

# Keep loopback: the Pi 5 gateway and Cloudflare Tunnel publish the API as
# api.contextshrink.com. Do not bind the LAN.
API_BIND=127.0.0.1

# Browser origins allowed to call the API (the dashboard is cross-origin).
# Must include https://code.contextshrink.com for the ContextShrink Code site.
CORS_ORIGINS=https://app.contextshrink.com,https://code.contextshrink.com,http://localhost:5173,http://127.0.0.1:5173

SESSION_TTL_DAYS=30

# Free accounts get compression until they save this much (USD) in the
# current UTC month; later requests pass through uncompressed.
FREE_SAVINGS_CAP_USD=20

# Days a failed savings-fee payment may stay unpaid before Pro features
# pause (Free cap, no Advanced Analytics) until the invoice is paid.
FEE_GRACE_DAYS=7

# Must match the proxy's server-only credential (openssl rand -hex 48).
CONTEXTSHRINK_SERVICE_TOKEN=change-me

# Stripe sandbox keys are server-managed by the API environment. Never put the
# secret key in frontend variables, source code, chat, or a committed .env file.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret of the /api/stripe/webhook endpoint (whsec_...). Created by
# api/stripe_setup.py --webhook-url ... --print-webhook-secret.
STRIPE_WEBHOOK_SECRET=

# ContextShrink Code subscription. Base64 of a 32-byte raw Ed25519 seed that
# signs entitlements. Never commit it; the matching public key is compiled into
# the engine. Unset: /code/entitlement returns 503.
CODE_ENTITLEMENT_PRIVATE_KEY=
# Optional overrides. Defaults shown.
# CODE_SITE_URL=https://code.contextshrink.com
# CODE_API_URL=https://api.contextshrink.com
# STRIPE_CODE_PRICE_LOOKUP_KEY=contextshrink_code_monthly

# Public dashboard origin used for Checkout and Customer Portal return URLs.
APP_URL=https://app.contextshrink.com

# Team rollout and optional OIDC sign-in. Keep off until schema and IdP tested.
CONTEXTSHRINK_TEAMS_ENABLED=false
CONTEXTSHRINK_TEAM_SSO_ENABLED=false
# Exact comma-separated IdP hosts approved by the operator (no wildcards).
# Include discovery, authorization, token and JWKS hosts; public HTTPS only.
SSO_ALLOWED_HOSTS=
SSO_API_URL=https://api.contextshrink.com
# Generate privately with cryptography.fernet.Fernet.generate_key().
# Keep in the server secret store and back up securely; never paste into chat.
SSO_ENCRYPTION_KEY=
