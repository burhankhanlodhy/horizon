# Copy this file to .env and fill in real values before running.
# docker-compose.yml requires these — it will refuse to start with defaults.

# Neo4j credentials for the graph memory backend (format: user/password).
NEO4J_AUTH=neo4j/CHANGEME
# Password only, for library / non-Docker use of the Neo4j memory backend.
NEO4J_PASSWORD=CHANGEME

# Proxy token — gates the data plane whenever the proxy is not loopback-only.
# Generate: openssl rand -hex 32
HORIZON_PROXY_TOKEN=CHANGEME

# Pi account deployment: same server-only value in proxy and control-plane env.
# Generate: openssl rand -hex 48. Never send this credential to browsers/tools.
CONTEXTSHRINK_API_URL=http://127.0.0.1:8788
CONTEXTSHRINK_SERVICE_TOKEN=CHANGEME

# Keep idle sessions' prompt caches warm with pre-warm pings (1 = on). Each
# ping is billed to the account's provider key and counted against its savings.
# HORIZON_CACHE_KEEPALIVE=1

# Optional: set to 0.0.0.0 to expose the proxy on the network (requires a token).
# HORIZON_BIND_ADDR=127.0.0.1

# Per-user API-key store location (default: <workspace>/keys.db inside the
# horizon_workspace volume). Override only if you want the key DB elsewhere.
# HORIZON_KEYS_PATH=

# Public DNS name for the optional TLS front (docker compose --profile tls).
# Required only when the tls profile is enabled; Caddy uses it to obtain
# certificates automatically. Point an A/AAAA record at the VPS first.
# HORIZON_PUBLIC_DOMAIN=horizon.example.com
