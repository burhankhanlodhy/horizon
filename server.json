{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.your-org/horizon",
  "description": "Horizon MCP server for compression, retrieval, and stats in MCP-compatible hosts.",
  "title": "Horizon",
  "websiteUrl": "https://your-org.github.io/horizon/",
  "repository": {
    "url": "https://github.com/your-org/horizon",
    "source": "github",
    "id": "1129940957"
  },
  "version": "0.42.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "horizon-ai",
      "version": "0.42.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "horizon-ai[mcp]"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "horizon"
        },
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
