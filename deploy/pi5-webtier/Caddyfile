# Pi 5 gateway: the only way into the Pi 5 (via its Cloudflare Tunnel). Every
# listener is loopback-only; nothing is exposed on the LAN.
#
#   127.0.0.1:8791     loopback, Pi 5 Cloudflare Tunnel (api.contextshrink.com):
#                      public control-plane API routes only.
#   127.0.0.1:8790     loopback, Pi 5 Cloudflare Tunnel (proxy.contextshrink.com):
#                      provider operations only. Never point the tunnel at the
#                      proxy itself (127.0.0.1:8787) or the API (127.0.0.1:8788):
#                      this gateway is what allowlists routes and strips edge
#                      headers.

(proxy_routes) {
	# Only supported provider operations may reach the data plane, plus the
	# cache keep-alive's session end (wrap reports its tool exited; the proxy
	# ends only sessions owned by the caller's account). A /k/<id> segment
	# carries the keep-alive id for clients that cannot send its header (Codex).
	# The outer ASGI middleware validates the account key, including on loopback.
	@proxy_operations path_regexp provider ^((/p/[^/]+)?(/k/[A-Za-z0-9_-]{1,64})?(/(anthropic/)?v1/messages|/(v1/)?chat/completions|/(v1/(codex/)?|backend-api/(codex/)?)?responses|/v1(beta)?/models/[^/]+:(generateContent|streamGenerateContent|countTokens)|/v1/models(/[^/]+)?|/v1/messages/count_tokens)|/v1/horizon/keepalive/end)/?$
	handle @proxy_operations {
		reverse_proxy 127.0.0.1:8787 {
			header_up Host 127.0.0.1:8787
			# Edge headers from Cloudflare and the Caddy hops must not reach
			# providers: many sit behind Cloudflare too, and a forwarded
			# CDN-Loop/CF-* header makes Cloudflare refuse the request (HTML
			# 403). They would also leak the caller's IP and country upstream.
			header_up -Cdn-Loop
			header_up -Cf-Connecting-Ip
			header_up -Cf-Ipcountry
			header_up -Cf-Ray
			header_up -Cf-Visitor
			header_up -Cf-Warp-Tag-Id
			header_up -Cf-Ew-Via
			header_up -Cf-Worker
			header_up -True-Client-Ip
			header_up -Via
			header_up -X-Forwarded-For
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Proto
			header_up -X-Real-Ip
		}
	}
}

(api_routes) {
	# Public control-plane routes only; /internal/* (service token), the
	# legacy /ingest and FastAPI's /docs and /openapi.json stay private.
	@public_api path_regexp api ^/(healthz|auth/(signup|login|logout|me)|subscription|billing/(estimate|checkout|portal|renew|invoices)|usage/summary|keys(/[^/]+)?|analytics/(summary|feed|history\.csv)|stripe/webhook)$
	handle @public_api {
		reverse_proxy 127.0.0.1:8788 {
			header_up -Cdn-Loop
			header_up -Via
		}
	}
}

# proxy.contextshrink.com
:8790 {
	bind 127.0.0.1
	import proxy_routes
	handle {
		respond "Not Found" 404
	}
}

# api.contextshrink.com: the dashboard, the Advanced Analytics page and the
# desktop app call the control-plane API here.
:8791 {
	bind 127.0.0.1
	import api_routes
	handle {
		respond "Not Found" 404
	}
}
